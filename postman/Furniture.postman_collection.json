    {
      "name": "Создать заказ: свободного замерщика нет",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{ordersUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"executionAddress\": \"Владимир, улица Мира, 10\",\n  \"description\": \"Шкаф по индивидуальному заказу\",\n  \"customerWishes\": \"Светлая мебель\",\n  \"plannedCompletionDate\": \"2026-12-15T12:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = JSON.parse(pm.request.body.raw); b.clientId = Number(pm.collectionVariables.get('clientId')); pm.request.body.update(JSON.stringify(b));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const r = pm.response.json(); pm.collectionVariables.set('waitingOrderId', r.order.id);",
              "pm.test('Заказ остаётся New', () => pm.expect(r.order.status).to.eql('New'));",
              "pm.test('Этап ожидает исполнителя', () => pm.expect(r.order.stages[0].status).to.eql('WaitingForAssignee'));",
              "pm.test('Назначения нет', () => {pm.expect(r.measurerAssigned).to.eql(false); pm.expect(r.order.assignments).to.have.lengthOf(0);});"
            ]
          }
        }
      ]
    },
