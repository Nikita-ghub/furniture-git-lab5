{
  "info": {
    "name": "Мебельное производство - ЛР 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Три сервиса, две базы PostgreSQL. Запускайте коллекцию целиком по порядку. Первый запуск рассчитан на базу с одним bootstrap-администратором; повторный возможен, если все ранее созданные замерщики заняты."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminLogin}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPassword}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', Date.now().toString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Работает сервис: Сотрудники",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{employeesUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Работает сервис: Заказы",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{ordersUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
