            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const e = pm.response.json(); pm.collectionVariables.set('adminId', e.id); pm.collectionVariables.set('adminName', e.fullName);",
              "pm.test('Хеш не возвращается', () => pm.expect(e).not.to.have.property('passwordHash'));"
            ]
