    {
      "name": "Создать заказ: назначить замерщика",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{ordersUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"executionAddress\": \"Владимир, улица Мира, 10\",\n  \"description\": \"Шкаф по индивидуальному заказу\",\n  \"customerWishes\": \"Светлая мебель\",\n  \"plannedCompletionDate\": \"2026-12-15T12:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = JSON.parse(pm.request.body.raw); b.clientId = Number(pm.collectionVariables.get('clientId')); pm.request.body.update(JSON.stringify(b));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const r = pm.response.json(); pm.collectionVariables.set('assignedOrderId', r.order.id);",
              "pm.test('Заказ перешёл к замеру', () => pm.expect(r.order.status).to.eql('MeasurementAndApproval'));",
              "pm.test('Назначен созданный замерщик', () => pm.expect(r.measurerId).to.eql(Number(pm.collectionVariables.get('measurerId'))));",
              "pm.test('Этап назначен', () => pm.expect(r.order.stages[0].status).to.eql('Assigned'));",
              "pm.test('Ответственный - текущий администратор', () => pm.expect(r.order.responsibleAdministratorId).to.eql(Number(pm.collectionVariables.get('adminId'))));",
              "pm.test('Назначение и смена статуса в истории', () => {pm.expect(r.order.history.map(h => h.action)).to.include('MeasurerAssigned'); pm.expect(r.order.history.map(h => h.action)).to.include('OrderStatusChanged');});"
            ]
          }
        }
      ]
    },
